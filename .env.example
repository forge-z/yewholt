# Optional. Yewholt starts without provider credentials.
# Copy the lines you need into the daemon env file
# (~/.yewholt/.env, or $YEWHOLT_HOME/.env). `yewholt start` loads that file
# (mode 0600). A variable already set in the process environment wins.
#
# Do not put Claude subscription OAuth tokens here, and do not set
# ANTHROPIC_OAUTH_TOKEN. Anthropic needs an API key. For openai-codex,
# log in through Pi as the daemon user; it reads the saved OAuth credential.

# Optional name for this daemon in Buzz's member list.
# YEWHOLT_NAME="Yewholt watcher"

# Default model for new sessions, as provider/modelId.
# YEWHOLT_MODEL=anthropic/claude-sonnet-4-5

# Per-turn token charge and the default per-session cap.
# YEWHOLT_TURN_TOKENS=1000
# YEWHOLT_BUDGET_TOKENS=100000

# Hex pubkeys (comma or space separated) that may answer code-bot approvals
# besides the install owner. Everyone else's aprovo/rejeito is ignored.
# YEWHOLT_ADMINS=

# Sleeping VMs (README "Sleeping VMs"). With both set, agents announce the
# wake URL and the daemon closes its relay connections after the idle minutes
# so the provider can pause the VM; any request to the port reconnects it.
# YEWHOLT_WAKE_URL=https://my-vm.example/
# YEWHOLT_WAKE_PORT=8787
# YEWHOLT_IDLE_MINUTES=10

# On a sleeping daemon only: public key of a trusted always-on watcher.
# Enables wake on DMs and private channels by sharing the agents' signing keys.
# YEWHOLT_WATCHER_PUBKEY=

# State directory. Defaults to ~/.yewholt. Set this in the shell that runs
# `yewholt start` if you do not want the default; the file cannot point at
# itself.
# YEWHOLT_HOME=

# One provider is registered only when its own credential resolves.

# amazon-bedrock — any one of these (access keys need the secret too)
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_CONTAINER_CREDENTIALS_RELATIVE_URI=
# AWS_CONTAINER_CREDENTIALS_FULL_URI=
# AWS_WEB_IDENTITY_TOKEN_FILE=

# ant-ling
# ANT_LING_API_KEY=

# anthropic — API key only. Values containing sk-ant-oat are ignored.
# ANTHROPIC_API_KEY=

# azure
# AZURE_OPENAI_API_KEY=

# baseten
# BASETEN_API_KEY=

# cerebras
# CEREBRAS_API_KEY=

# cloudflare-ai-gateway — all three
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_GATEWAY_ID=

# cloudflare-workers-ai — key and account id (same names as the gateway)
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=

# deepseek
# DEEPSEEK_API_KEY=

# fireworks
# FIREWORKS_API_KEY=

# github-copilot
# COPILOT_GITHUB_TOKEN=

# google — Gemini API key. GOOGLE_API_KEY is not read.
# GEMINI_API_KEY=

# google-vertex — API key, or credentials path plus project and location
# GOOGLE_CLOUD_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_CLOUD_PROJECT=
# GCLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=

# groq
# GROQ_API_KEY=

# huggingface
# HF_TOKEN=

# kimi-coding
# KIMI_API_KEY=

# meta
# META_API_KEY=

# minimax
# MINIMAX_API_KEY=

# minimax-cn
# MINIMAX_CN_API_KEY=

# mistral
# MISTRAL_API_KEY=

# moonshotai and moonshotai-cn share this key
# MOONSHOT_API_KEY=

# nvidia
# NVIDIA_API_KEY=

# openai
# OPENAI_API_KEY=

# openrouter
# OPENROUTER_API_KEY=

# qwen-token-plan — either variable
# QWEN_TOKEN_PLAN_TEAM_API_KEY=
# QWEN_TOKEN_PLAN_API_KEY=

# qwen-token-plan-cn — either variable
# QWEN_TOKEN_PLAN_TEAM_CN_API_KEY=
# QWEN_TOKEN_PLAN_CN_API_KEY=

# qwen-token-plan-individual — either variable
# QWEN_TOKEN_PLAN_INDIVIDUAL_API_KEY=
# QWEN_TOKEN_PLAN_API_KEY=

# qwen-token-plan-individual-cn — either variable
# QWEN_TOKEN_PLAN_INDIVIDUAL_CN_API_KEY=
# QWEN_TOKEN_PLAN_CN_API_KEY=

# radius
# RADIUS_API_KEY=

# together
# TOGETHER_API_KEY=

# typesafe
# TYPESAFE_API_KEY=

# vercel-ai-gateway
# AI_GATEWAY_API_KEY=

# xai
# XAI_API_KEY=

# xiaomi
# XIAOMI_API_KEY=

# xiaomi-token-plan-ams
# XIAOMI_TOKEN_PLAN_AMS_API_KEY=

# xiaomi-token-plan-cn
# XIAOMI_TOKEN_PLAN_CN_API_KEY=

# xiaomi-token-plan-sgp
# XIAOMI_TOKEN_PLAN_SGP_API_KEY=

# zai
# ZAI_API_KEY=

# zai-coding-cn
# ZAI_CODING_CN_API_KEY=
