# Optional provider keys. Yewholt starts, creates bots, and resumes after
# kill -9 with none of these set. The Onboarding Specialist understands the
# chat commands in the README without calling a model. A key is used only when
# a session sends free text to a model in the pi-ai catalog.
#
# Do not put Claude subscription OAuth tokens here. API keys only.

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Default model for new sessions that should call a provider, as provider/modelId
# (a pi-ai catalog id, for example openai/gpt-6-sol). Display names such as
# "GPT-6.2 Astra" are stored as requested and slug to openai/gpt-6.2-astra;
# generation works once that id exists in the catalog for a configured key.
# YEWHOLT_MODEL=

# Per-turn token charge for interpreter turns, and the default per-session cap.
# YEWHOLT_TURN_TOKENS=1000
# YEWHOLT_BUDGET_TOKENS=100000

# State directory. Defaults to ~/.yewholt.
# YEWHOLT_HOME=
